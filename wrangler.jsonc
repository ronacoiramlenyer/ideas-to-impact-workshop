{
  "name": "ideas-to-impact",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  // public/index.html is bundled into the Worker as text (no separate asset upload).
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "durable_objects": { "bindings": [{ "name": "SESSION", "class_name": "Session" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }]
}
